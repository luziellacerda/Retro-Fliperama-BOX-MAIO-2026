+    header("LZTurbo / LZFramesControl (LZGAMES)");
+    {
+        static const char* lzProfiles[] = { "LZTurboX", "LZTurboX1", "LZTurboX2", "LZTurboX3", "LZTurboX4" };
+        int& prof = config::LZDeviceProfile.get();
+        if (ImGui::BeginCombo("LZTurbo (Device Profile)", lzProfiles[std::min(std::max(prof, 0), 4)]))
+        {
+            for (int i = 0; i < IM_ARRAYSIZE(lzProfiles); i++)
+            {
+                bool sel = (prof == i);
+                if (ImGui::Selectable(lzProfiles[i], sel))
