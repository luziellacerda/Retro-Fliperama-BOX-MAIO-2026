+                if (sel)
+                    ImGui::SetItemDefaultFocus();
+            }
+            ImGui::EndCombo();
+        }
+        ShowHelpMarker("Selects performance tweaks for your LZTurboX* hardware (weaker/stronger Amlogic X series). The launcher applies profile-specific settings (resolution etc) on launch.");
